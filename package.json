{
  "name": "@matrix2305/opencode-node",
  "version": "0.2.1",
  "description": "OpenCode V2 node plugin: full setup sync (agents, skills, commands, plugins, models, MCP, credentials, memory) from a remote OpenCode hub.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./cli": "./dist/cli.js",
    "./rpc": "./dist/rpc.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0 <3",
    "@opentui/core": ">=0.8.4",
    "@opentui/solid": ">=0.8.4",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.0",
    "@opentui/core": "^0.8.4",
    "@opentui/solid": "^0.8.4",
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.17",
    "tsup": "^9.0.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "oc-node": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "agents",
    "skills",
    "mcp",
    "sync",
    "hub"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matrix2305/opencode-node.git"
  },
  "author": "matrix2305"
}
